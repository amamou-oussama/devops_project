pipeline {

    environment {

        registry = "amamououssama/devopsimage"

        registryCredential = 'dockerHub'

        dockerImage = ''

    }
 
    agent any
 
    stages {

        stage('CHECKOUT GIT') {

            steps {

                git 'https://github.com/amamou-oussama/devops_project'

            }

        }
 
        stage('MVN CLEAN') {

            steps {

                sh 'mvn clean'

            }

        }
 
        stage('ARTIFACT CONSTRUCTION') {

            steps {

                echo 'ARTIFACT CONSTRUCTION...'

                sh 'mvn package -Dmaven.test.skip=true -P test-coverage'

            }

        }
 
        stage('UNIT TESTS') {

            steps {

                echo 'launching Unit Tests...'

                sh 'mvn test'

            }

        }
 
        stage('MVN SONARQUBE') {

            steps {

sh 'mvn sonar:sonar -Dsonar.host.url=http://192.168.6.160:9000 -Dsonar.login=sqa_405c687b2d9d4d34e45a4a2658906fc3b9f468da'

            }

        }
 
        stage('BUILDING OUR IMAGE') {

            steps {

                script {

                    dockerImage = docker.build registry + ":$BUILD_NUMBER"

                }

            }

        }
 
        stage('DEPLOY OUR IMAGE') {

            steps {

                script {

                    docker.withRegistry('', registryCredential) {

                        dockerImage.push()

                    }

                }

            }

        }

    }

}
